# Copy to .env and set values. Never commit real secrets.
GROQ_API_KEY=
# Dual-model routing:
# - runtime = single-file / crash debugging (fast)
# - audit   = full-repo finding enrichment (stronger)
GROQ_MODEL_RUNTIME=openai/gpt-oss-20b
GROQ_MODEL_AUDIT=openai/gpt-oss-120b
# Backward compatible alias (used if GROQ_MODEL_RUNTIME unset)
GROQ_MODEL=openai/gpt-oss-20b
EYRA_HOST=127.0.0.1
EYRA_PORT=8000
EYRA_DB_PATH=./data/eyra_memory.sqlite
EYRA_ALLOW_LOCAL_FALLBACK=true
EYRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Eyraaaa CodeAudit engine (proxied at /api/audit/*)
EYRA_AUDIT_BASE_URL=http://127.0.0.1:5000
# Max findings sent to audit LLM enrichment
EYRA_AUDIT_ENRICH_LIMIT=12
# Sandbox Python execute timeout (seconds)
EYRA_EXEC_TIMEOUT_S=3.0
